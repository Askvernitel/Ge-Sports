# Copy to .env and adjust. Every value below has a working default baked
# into src/config/env.ts, so the server boots in "degraded stub mode" even
# with no .env file at all - see README.md for what that means.

NODE_ENV=development
PORT=4000

# Requires a replica set (even a single-node one) because Mongoose
# transactions are used throughout (wallet/room/settlement writes).
MONGO_URI=mongodb://127.0.0.1:27017/pubg_wager?replicaSet=rs0

REDIS_URL=redis://127.0.0.1:6379

# Change these in any real deployment.
JWT_ACCESS_SECRET=dev-access-secret-change-me-please
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

SOLANA_RPC_URL=https://api.devnet.solana.com
# SPL mint address (9 decimals) created via `spl-token create-token`. Unset = deposits/withdrawals return CHAIN_ERROR.
SOLANA_TOKEN_MINT=
# JSON array of secret key bytes, e.g. the contents of a solana-keygen file. Unset = treasury features (deposits/withdrawals/faucet-onchain) degrade gracefully.
TREASURY_SECRET_KEY=

# Unset = MockPubgProvider (deterministic fake data) is used instead of the real PUBG API.
PUBG_API_KEY=
PUBG_API_BASE_URL=https://api.pubg.com

# Shared-secret header the KYC webhook must present. Change in real deployments.
KYC_SHARED_SECRET=dev-kyc-webhook-secret
KYC_MOCK_AUTO_APPROVE=true

FEATURE_DEV_FAUCET=true
FEATURE_DEPOSIT_POLLER=true

CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=info
